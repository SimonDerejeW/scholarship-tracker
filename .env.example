# Copy to .env and fill in. Never commit .env.

# Postgres connection string. The default matches docker-compose.yml.
DATABASE_URL=postgres://scholarship:scholarship@localhost:5432/scholarship

# The Admin's email (ADR 0004). This person can always sign in.
ADMIN_EMAIL=you@example.com

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public URL, used to build the Google redirect URI.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
